{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "System Usage",
  "Version": "1.2.0.0",
  "Author": "Corrugator",
  "UUID": "com.corrugator.systemusage",
  "Actions": [
    {
      "Name": "Memory",
      "UUID": "com.corrugator.systemusage.memory",
      "Icon": "imgs/actions/memory/icon",
      "Tooltip": "Shows macOS memory pressure or used/total RAM as a colored percentage.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/memory/key",
          "TitleAlignment": "bottom"
        }
      ],
      "PropertyInspectorPath": "ui/memory-pi.html"
    },
    {
      "Name": "CPU",
      "UUID": "com.corrugator.systemusage.cpu",
      "Icon": "imgs/actions/cpu/icon",
      "Tooltip": "Shows macOS CPU usage as a colored percentage.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/cpu/key",
          "TitleAlignment": "bottom"
        }
      ],
      "PropertyInspectorPath": "ui/cpu-pi.html"
    },
    {
      "Name": "GPU",
      "UUID": "com.corrugator.systemusage.gpu",
      "Icon": "imgs/actions/gpu/icon",
      "Tooltip": "Shows macOS GPU utilization as a colored percentage.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/gpu/key",
          "TitleAlignment": "bottom"
        }
      ],
      "PropertyInspectorPath": "ui/gpu-pi.html"
    },
    {
      "Name": "Network",
      "UUID": "com.corrugator.systemusage.network",
      "Icon": "imgs/actions/network/icon",
      "Tooltip": "Shows network download and upload rates with a history graph.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/network/key",
          "TitleAlignment": "bottom"
        }
      ],
      "PropertyInspectorPath": "ui/network-pi.html"
    },
    {
      "Name": "Temperature",
      "UUID": "com.corrugator.systemusage.temperature",
      "Icon": "imgs/actions/temperature/icon",
      "Tooltip": "Shows the SoC/CPU, battery or SSD temperature with fan speed or power.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/temperature/key",
          "TitleAlignment": "bottom"
        }
      ],
      "PropertyInspectorPath": "ui/temperature-pi.html"
    },
    {
      "Name": "Fan",
      "UUID": "com.corrugator.systemusage.fan",
      "Icon": "imgs/actions/fan/icon",
      "Tooltip": "Shows fan speed in RPM, with the ring as share of maximum speed.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/fan/key",
          "TitleAlignment": "bottom"
        }
      ],
      "PropertyInspectorPath": "ui/fan-pi.html"
    },
    {
      "Name": "Battery",
      "UUID": "com.corrugator.systemusage.battery",
      "Icon": "imgs/actions/battery/icon",
      "Tooltip": "Shows battery charge with time remaining, power or health.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/battery/key",
          "TitleAlignment": "bottom"
        }
      ],
      "PropertyInspectorPath": "ui/battery-pi.html"
    },
    {
      "Name": "Disk",
      "UUID": "com.corrugator.systemusage.disk",
      "Icon": "imgs/actions/disk/icon",
      "Tooltip": "Shows used disk space of a volume as a colored percentage.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/disk/key",
          "TitleAlignment": "bottom"
        }
      ],
      "PropertyInspectorPath": "ui/disk-pi.html"
    },
    {
      "Name": "Disk I/O",
      "UUID": "com.corrugator.systemusage.diskio",
      "Icon": "imgs/actions/diskio/icon",
      "Tooltip": "Shows disk read and write rates with a history graph.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/diskio/key",
          "TitleAlignment": "bottom"
        }
      ],
      "PropertyInspectorPath": "ui/diskio-pi.html"
    }
  ],
  "Category": "System Usage",
  "CategoryIcon": "imgs/plugin/category",
  "CodePath": "bin/plugin.js",
  "Description": "Shows macOS system stats on Stream Deck keys: memory, CPU, GPU, temperature, fans, battery and disk as colored percentages, plus network and disk I/O rates, with optional detail lines and history graphs.",
  "Icon": "imgs/plugin/icon",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "6.9"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12.0"
    }
  ],
  "Nodejs": {
    "Version": "20"
  }
}